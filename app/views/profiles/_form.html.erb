<%= form_with model: @profile, 
                url: url, method: method, 
                id: 'profile-form', 
                data: { controller: 'profiles', action: 'turbo:submit-start->profiles#test' },
                class: 'm-5', html: {autocomplete: "off"} do |form| %>
    
    <%= render 'personal_details' %>
    <%= render 'professional_details' %>
    <%= render 'relation_details' %>
    <%= render 'custom_field_details' if @custom_fields_with_values.present? %>

    <%= button_to "Submit", class: 'form-control btn btn-primary' do %>
        Submit
    <% end %>
<% end %>
