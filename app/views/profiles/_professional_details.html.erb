<h4>Profession Details</h4>

<div class="row py-3">
    <div class="col-4">
        <span class='form-label text-body-secondary'>
            Profession
        </span>
    </div>
    <div class="col-6">
        <%= text_field_tag :profession,
            @profile&.profession || '',
            placeholder: "Enter Profession",
            class: 'form-control'
        %> 
    </div>
</div>

<div class="row py-3">
    <div class="col-4">
        <span class='form-label text-body-secondary'>
            Profession Details
        </span>
    </div>
    <div class="col-6">
        <%= text_area_tag :profession_details,
            @profile&.profession_details || '',
            placeholder: 'Enter Profession Details',
            class: 'form-control'
        %> 
    </div>
</div>

