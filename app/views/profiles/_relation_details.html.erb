<h4>Relation</h4>

<div class="row py-3">
    <div class="col-4">
        <span class='form-label text-body-secondary'>
            Relation
        </span>
    </div>
    <div class="col-6">
        <%= select_tag "profiles[relation]",
            options_for_select(Profile.relations.keys.map { |relation| [relation.capitalize, relation] }, @profile&.relation),
            class: 'form-control'
        %> 
    </div>
</div>

<div class="row py-3">
    <div class="col-4">
        <span class='form-label text-body-secondary'>
            First Meet Details
        </span>
    </div>
    <div class="col-6">
        <%= text_area_tag "profiles[first_meet_details]",
            @profile&.first_meet_details || '',
            placeholder: 'Enter the details of your First meet with this profile subject',
            class: 'form-control'
        %> 
    </div>
</div>

<div class="row py-3">
    <div class="col-4">
        <span class='form-label text-body-secondary'>
            Last Meet Details
        </span>
    </div>
    <div class="col-6">
        <%= text_area_tag "profiles[last_meet_details]",
            @profile&.last_meet_details || '',
            placeholder: 'Enter the details of your Last meet with this profile subject',
            class: 'form-control'
        %> 
    </div>
</div>

<div class="row py-3">
    <div class="col-4">
        <span class='form-label text-body-secondary'>
            Qualities
        </span>
    </div>
    <div class="col-6">
        <%= text_area_tag "profiles[qualities]",
            @profile&.qualities || '',
            placeholder: 'Enter Qualities',
            class: 'form-control'
        %> 
    </div>
</div>

<div class="row py-3">
    <div class="col-4">
        <span class='form-label text-body-secondary'>
            Connection Score
        </span>
    </div>
    <div class="col-6">
        <%= select_tag "profiles[connection_score]",
            options_for_select(Profile.connection_scores.keys.map { |score| [score.capitalize, score] }, @profile&.connection_score),
            class: 'form-control'
        %> 
    </div>
</div>

<div class="row py-3">
    <div class="col-4">
        <span class='form-label text-body-secondary'>
            Interest Areas
        </span>
    </div>
    <div class="col-6">
        <%= text_area_tag "profiles[interest_areas_list]",
            @profile&.interest_areas_list || '',
            placeholder: 'Enter the Interest Areas for this profile subject',
            class: 'form-control'
        %> 
    </div>
</div>