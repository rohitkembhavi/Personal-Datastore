<%#
    {
        :first_name=>"john", 
        :last_name=>"doe", 
        :email=>"john.doe@mail.com", 
        :custom_field_values_attributes=>[
            {:value=>"green", :custom_field_id=>2}
        ]
    }
 %>

<%# https://www.ombulabs.com/blog/learning/rails/nested-forms.html %>

<h4>Custom Fields</h4>

<% @custom_fields_with_values.each do |id, value_set| %>

    <%= hidden_field_tag 'custom_field_values_attributes[][id]', value_set[:cfv_id] if value_set[:cfv_id] %>
    <%= hidden_field_tag 'custom_field_values_attributes[][custom_field_id]', id  %>

    <div class="row py-3">
        <div class="col-4">
            <span class='form-label text-body-secondary'>
                <%= value_set[:name] %>
            </span>
        </div>
        
        <div class="col-6">
            <% case value_set[:type] %>
            <% when :text %>
                <%= text_field_tag "custom_field_values_attributes[][value]",
                                    value_set[:value_for_current_profile] || '',
                                    placeholder: "Enter #{value_set[:name]}",
                                    class: 'form-control' %>
            <% when :number %>
                <%= number_field_tag "custom_field_values_attributes[][value]",
                                    value_set[:value_for_current_profile] || '',
                                    placeholder: "Enter #{value_set[:name]}",
                                    class: 'form-control' %>
            <% when :boolean %>
                <%# TRUE %>
                <div class="form-check form-check-inline">
                    <%= radio_button_tag "custom_field_values_attributes[][value]", 
                            "true",
                            ( value_set[:value_for_current_profile] == "true" ),
                            class: "form-check-input" %>
                    <label class="form-check-label" for="inlineCheckbox1">True</label>
                </div>
                <%# FALSE %>
                <div class="form-check form-check-inline">
                    <%= radio_button_tag "custom_field_values_attributes[][value]", 
                            "false",
                            ( value_set[:value_for_current_profile] == "false" ),
                            class: "form-check-input" %>
                    <label class="form-check-label" for="inlineCheckbox1">False</label>
                </div>                
            <% end %> 
        </div>
    </div>
<% end %>
    
